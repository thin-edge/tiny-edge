#
# What the NuttX build of tiny-edge generates before it compiles, from the
# NuttX configuration:
#
#   cmake -DCONFIG=<nuttx>/.config -DOUT=<dir> -P generate.cmake
#
#   <dir>/tedge_config.h       the core's TEDGE_* options, from CONFIG_TEDGE_*
#   <dir>/tedge_ca_bundle.inc  the trust anchors in TEDGE_C8Y_CA_FILES
#   <dir>/tedge_download_ca.inc  the download-only roots in
#                              TEDGE_DOWNLOAD_CA_FILES
#   <dir>/sources.mk           the core's and the provisioning library's
#                              sources for the options that are on, from
#                              core/sources.cmake: the list every port uses
#
# Each file is written only when its content changes, so make rebuilds only
# what an option change touches.

cmake_minimum_required(VERSION 3.20)
get_filename_component(TEDGE_ROOT ${CMAKE_CURRENT_LIST_DIR}/../../.. ABSOLUTE)
foreach(_var CONFIG OUT)
  if(NOT ${_var})
    message(FATAL_ERROR "generate.cmake: -D${_var}= is required")
  endif()
endforeach()

# --- The NuttX configuration --------------------------------------------

file(STRINGS ${CONFIG} _lines REGEX "^CONFIG_TEDGE_[A-Z0-9_]+=")
foreach(_line ${_lines})
  string(REGEX MATCH "^CONFIG_(TEDGE_[A-Z0-9_]+)=(.*)$" _ "${_line}")
  set(_name ${CMAKE_MATCH_1})
  set(_value "${CMAKE_MATCH_2}")
  if(_value STREQUAL "y")
    set(${_name} ON)
  else()
    set(${_name} "${_value}")
  endif()
endforeach()

# --- tedge_config.h -----------------------------------------------------

# Every option this port's Kconfig declares, mapped by name: an option
# added there reaches the core without a list to update. NuttX's
# <nuttx/config.h> defines a bool that is on as 1, and a string with its
# quotes, as the core expects.
file(STRINGS ${CMAKE_CURRENT_LIST_DIR}/../Kconfig _decls
  REGEX "^[ \t]*(menu)?config[ \t]+TEDGE")
set(_names "")
foreach(_decl ${_decls})
  string(REGEX REPLACE "^[ \t]*(menu)?config[ \t]+(TEDGE[A-Z0-9_]*).*" "\\2"
    _name "${_decl}")
  list(APPEND _names ${_name})
endforeach()
list(REMOVE_DUPLICATES _names)
list(SORT _names)
set(_body "")
foreach(_name ${_names})
  string(APPEND _body
    "#if defined(CONFIG_${_name})\n#define ${_name} CONFIG_${_name}\n#endif\n")
endforeach()
file(CONFIGURE OUTPUT ${OUT}/tedge_config.h CONTENT
"/* Generated by ports/nuttx/tools/generate.cmake. Do not edit. */
#ifndef TEDGE_CONFIG_H_
#define TEDGE_CONFIG_H_

#include <nuttx/config.h>

/* How a user of this port names an option, for messages that tell them
 * which one to change. */
#define TEDGE_CONFIG_NAME(name) \"CONFIG_\" #name

@_body@
#endif /* TEDGE_CONFIG_H_ */
" @ONLY)

# --- tedge_ca_bundle.inc ------------------------------------------------

string(REGEX REPLACE "^\"(.*)\"$" "\\1" _ca_files "${TEDGE_C8Y_CA_FILES}")
separate_arguments(_ca_files UNIX_COMMAND "${_ca_files}")
set(_bundle "")
foreach(_pem ${_ca_files})
  if(NOT IS_ABSOLUTE ${_pem})
    set(_pem ${TEDGE_ROOT}/${_pem})
  endif()
  if(NOT EXISTS ${_pem})
    message(FATAL_ERROR "CONFIG_TEDGE_C8Y_CA_FILES: no such file: ${_pem}")
  endif()
  file(READ ${_pem} _content HEX)
  string(APPEND _bundle "${_content}")
endforeach()
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bundle "${_bundle}")
file(CONFIGURE OUTPUT ${OUT}/tedge_ca_bundle.inc CONTENT "${_bundle}\n")

# --- tedge_download_ca.inc ----------------------------------------------

include(${TEDGE_ROOT}/ports/common/cmake/tedge_ca_bundle.cmake)
string(REGEX REPLACE "^\"(.*)\"$" "\\1" _dl_files "${TEDGE_DOWNLOAD_CA_FILES}")
tedge_download_ca_bundle(${OUT} "${_dl_files}")

# --- sources.mk ---------------------------------------------------------

include(${TEDGE_ROOT}/core/sources.cmake)
include(${TEDGE_ROOT}/provisioning/sources.cmake)
tedge_core_sources(_core "")
tedge_provisioning_sources(_provisioning "")
file(STRINGS ${TEDGE_ROOT}/VERSION _version LIMIT_COUNT 1)
list(JOIN _core " \\\n  " _core)
list(JOIN _provisioning " \\\n  " _provisioning)
file(CONFIGURE OUTPUT ${OUT}/sources.mk CONTENT
"# Generated by ports/nuttx/tools/generate.cmake. Do not edit.
TEDGE_VERSION = @_version@
TEDGE_CORE_SRCS = \\
  @_core@
TEDGE_PROVISIONING_SRCS = \\
  @_provisioning@
" @ONLY)
