#
# The core reads its build configuration as TEDGE_* macros from
# <tedge_config.h> and never sees a Kconfig symbol. On ESP-IDF that header
# is generated here, as the Zephyr port does it: one entry for each option
# this component's Kconfig declares,
#
#   #if defined(CONFIG_TEDGE_HEALTH)
#   #define TEDGE_HEALTH CONFIG_TEDGE_HEALTH
#   #endif
#
# so the values still come from sdkconfig.h, and an option added to the
# Kconfig reaches the core without anyone editing a mapping.

function(tedge_generate_config kconfig out_dir)
  file(STRINGS ${kconfig} _lines REGEX "^[ \t]*(menu)?config[ \t]+TEDGE")
  set(_names "")
  foreach(_line ${_lines})
    string(REGEX REPLACE "^[ \t]*(menu)?config[ \t]+(TEDGE[A-Z0-9_]*).*" "\\2"
      _name "${_line}")
    list(APPEND _names ${_name})
  endforeach()
  list(REMOVE_DUPLICATES _names)
  list(SORT _names)

  set(_body "")
  foreach(_name ${_names})
    string(APPEND _body
      "#if defined(CONFIG_${_name})\n#define ${_name} CONFIG_${_name}\n#endif\n")
  endforeach()

  file(CONFIGURE OUTPUT ${out_dir}/tedge_config.h CONTENT
"/* Generated by ports/freertos/esp-idf/tiny_edge/cmake/tedge_config.cmake. Do not edit. */
#ifndef TEDGE_CONFIG_H_
#define TEDGE_CONFIG_H_

#include <sdkconfig.h>

/* How a user of this port names an option, for messages that tell them
 * which one to change. */
#define TEDGE_CONFIG_NAME(name) \"CONFIG_\" #name

${_body}
#endif /* TEDGE_CONFIG_H_ */
" @ONLY)
endfunction()
