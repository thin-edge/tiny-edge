#
# The core reads its build configuration as TEDGE_* macros from
# <tedge_config.h>, and never sees a Kconfig symbol. On Zephyr that header is
# generated here: one entry for each option the port's Kconfig declares,
#
#   #if defined(CONFIG_TEDGE_HEALTH)
#   #define TEDGE_HEALTH CONFIG_TEDGE_HEALTH
#   #endif
#
# so the values still come from Kconfig (autoconf.h, or a test's -D flags),
# and an option added to Kconfig reaches the core without anyone editing a
# mapping by hand.

set(TEDGE_ZEPHYR_PORT_DIR ${CMAKE_CURRENT_LIST_DIR}/..)

# Writes <out_dir>/tedge_config.h. The file is only rewritten when its
# content changes, so a reconfigure does not rebuild the whole client.
# Zephyr already reconfigures when a Kconfig file changes, which is when
# the list of options can change.
function(tedge_generate_config out_dir)
  file(GLOB _kconfigs ${TEDGE_ZEPHYR_PORT_DIR}/Kconfig*)
  set(_names "")
  foreach(_kconfig ${_kconfigs})
    file(STRINGS ${_kconfig} _lines REGEX "^[ \t]*(menu)?config[ \t]+TEDGE")
    foreach(_line ${_lines})
      string(REGEX REPLACE "^[ \t]*(menu)?config[ \t]+(TEDGE[A-Z0-9_]*).*" "\\2"
        _name "${_line}")
      list(APPEND _names ${_name})
    endforeach()
  endforeach()
  # Declared by Zephyr's logging template ("module = TEDGE"), not by name.
  list(APPEND _names TEDGE_LOG_LEVEL)
  list(REMOVE_DUPLICATES _names)
  list(SORT _names)

  set(_body "")
  foreach(_name ${_names})
    string(APPEND _body
      "#if defined(CONFIG_${_name})\n#define ${_name} CONFIG_${_name}\n#endif\n")
  endforeach()

  file(CONFIGURE OUTPUT ${out_dir}/tedge_config.h CONTENT
"/* Generated by ports/zephyr/cmake/tedge_config.cmake. Do not edit. */
#ifndef TEDGE_CONFIG_H_
#define TEDGE_CONFIG_H_

/* How a user of this port names an option, for messages that tell them
 * which one to change. */
#define TEDGE_CONFIG_NAME(name) \"CONFIG_\" #name

${_body}
#endif /* TEDGE_CONFIG_H_ */
" @ONLY)
endfunction()
